# Stargaze / Star Tagger backend configuration. Copy to .env (scripts/setup.sh does this
# and generates JWT_SECRET). Never commit .env. Relative paths resolve from the repo root.

# --- API process ---
HOST=0.0.0.0              # alias: API_HOST
PORT=4000                 # alias: API_PORT
# Browser origins of the website (the only origins allowed for cookie writes). Comma-separated; the first is
# canonical. List the LAN origin people open (replace backend-host.lan), this machine, and the Next.js dev server.
# alias: CORS_ORIGIN
APP_ORIGIN=http://backend-host.lan:4000,http://localhost:4000,http://localhost:3000
# Set to the address of the local web proxy (e.g. 127.0.0.1) to trust its X-Forwarded-For.
TRUST_PROXY=127.0.0.1
LOG_LEVEL=info

# --- Storage ---
DB_PATH=./data/stargaze.sqlite
MEDIA_DIR=./data/media
BACKUP_DIR=./data/backups

# --- Auth ---
JWT_SECRET=               # generated by scripts/setup.sh; at least 32 characters
COOKIE_SECURE=false       # true only when served over HTTPS

# --- Guide (Gemma: Ollama native /api/chat, or OpenAI-compatible /v1/chat/completions e.g. Unsloth) ---
GUIDE_BASE_URL=http://guide-host.lan:11434   # alias: GEMMA_BASE_URL
GUIDE_MODEL=gemma4:e4b-it-q4_K_M             # alias: GEMMA_MODEL
GUIDE_TIMEOUT_MS=60000
GUIDE_THINK=false         # ollama: think:false; openai: chat_template_kwargs.enable_thinking=false
GUIDE_API_STYLE=ollama    # ollama | openai (Unsloth and other OpenAI-compatible servers)
GUIDE_API_KEY=            # optional Bearer key; set only in your local .env, never commit it

# --- Moderation (Clef Flash via /v1/systemone on Ollama or Unsloth) ---
CLEF_BASE_URL=http://moderation-host.lan:11434
CLEF_MODEL=clef-flash:9b-q8_0
CLEF_CALL_TIMEOUT_MS=30000
CLEF_JOB_TIMEOUT_MS=120000
CLEF_API_STYLE=ollama     # ollama | openai (health/models:check use /v1/models instead of /api/tags)
CLEF_API_KEY=             # optional Bearer key; set only in your local .env, never commit it
MODERATION_ENABLED=true   # false only for API-only debugging; content then stays pending
MODEL_LOCK_PATH=./docs/model-lock.json  # written only by successful models:check --write-lock

# Unsloth (OpenAI-compatible) example — see docs/operations.md "Unsloth model hosts":
# GUIDE_BASE_URL=http://<gemma-host>:8888
# GUIDE_MODEL=unsloth/gemma-4-26B-A4B-it-qat-GGUF
# GUIDE_API_STYLE=openai
# GUIDE_THINK=false
# GUIDE_API_KEY=<set locally>
# CLEF_BASE_URL=http://<clef-host>:8888
# CLEF_MODEL=bartowski/Cloudflare_clef-flash-GGUF:Q4_K_S
# CLEF_API_STYLE=openai
# CLEF_API_KEY=<set locally>

# --- Limits (defaults follow the spec) ---
CLAIM_COOLDOWN_SECONDS=3600
RATE_LOGIN_PER_MIN=10
RATE_SIGNUP_PER_HOUR=5
RATE_WRITES_PER_MIN=20
RATE_CHAT_PER_HOUR=30

# --- Web ---
# Next.js development server proxies /api to this upstream:
API_UPSTREAM=http://127.0.0.1:4000

# Astral Harness summaries (POST /api/agent/summary). Server-only; never commit a real key.
# XAI_API_KEY enables MP3 speech only when a request sets "audio": true. Leave blank for text-only.
XAI_API_KEY=
XAI_TTS_VOICE=eve
XAI_TTS_LANGUAGE=en
XAI_TTS_TIMEOUT_MS=8000
WIKIPEDIA_USER_AGENT=
RATE_SUMMARY_PER_HOUR=30

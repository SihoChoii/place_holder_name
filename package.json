{
  "name": "stargaze",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @stargaze/db generate",
    "db:migrate": "pnpm --filter @stargaze/db migrate",
    "db:push": "pnpm --filter @stargaze/db push",
    "db:studio": "pnpm --filter @stargaze/db studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev:web": "pnpm --filter @stargaze/web dev",
    "dev:api": "pnpm --filter @stargaze/api dev"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}

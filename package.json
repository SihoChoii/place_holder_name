{
  "name": "stargaze",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "turbo run dev --filter=@stargaze/api --filter=@stargaze/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "bash scripts/with-env.sh pnpm --filter @stargaze/db generate",
    "db:migrate": "bash scripts/with-env.sh pnpm --filter @stargaze/db migrate",
    "db:push": "bash scripts/with-env.sh pnpm --filter @stargaze/db push",
    "db:studio": "bash scripts/with-env.sh pnpm --filter @stargaze/db studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev:web": "pnpm --filter @stargaze/web dev",
    "dev:api": "pnpm --filter @stargaze/api dev",
    "ios:gen": "cd apps/ios && xcodegen generate"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}

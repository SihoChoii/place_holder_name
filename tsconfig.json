{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "declaration": true, "outDir": "dist", "rootDir": "src", "esModuleInterop": true,
    "skipLibCheck": true, "verbatimModuleSyntax": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}

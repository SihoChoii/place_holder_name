generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String?
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media     Media[]
  reactions Reaction[]

  @@map("users")
}

/// Catalog entry for a celestial object users can attach media to.
model Star {
  id          String   @id @default(cuid())
  /// Hipparcos / catalog ID when available
  catalogId   String?  @unique
  name        String
  /// Right ascension in hours (0–24)
  raHours     Float
  /// Declination in degrees (−90–90)
  decDegrees  Float
  magnitude   Float?
  constellation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media Media[]

  @@index([name])
  @@map("stars")
}

enum MediaType {
  IMAGE
  VIDEO
  TEXT
}

model Media {
  id          String    @id @default(cuid())
  starId      String
  authorId    String
  type        MediaType
  /// Caption or text body
  body        String?
  /// URL or local path for image/video
  mediaUrl    String?
  /// Where the media was captured (optional)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  star      Star       @relation(fields: [starId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([starId, createdAt])
  @@index([authorId])
  @@map("media")
}

model Reaction {
  id        String   @id @default(cuid())
  mediaId   String
  userId    String
  /// Emoji or short reaction key, e.g. "❤️", "wow"
  emoji     String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId, emoji])
  @@index([mediaId])
  @@map("reactions")
}
